# =====================================================================
#  system/ KLASÖRÜ – YALNIZCA ajax.php DIŞARIYA AÇIK
#  cilginyazilim.com – Form Doğrulama Örneği
# ---------------------------------------------------------------------
#  ÖLÇÜLEN SORUN: Projede hiç .htaccess yoktu.
#    /system/config.php    → HTTP 200
#    /system/function.php  → HTTP 200
#  İkisi de ekrana bir şey basmıyordu, bu yüzden "zararsız" görünüyordu.
#  Zararsız değildi: config.php her çağrıldığında bir VERİTABANI
#  BAĞLANTISI açar ve bir oturum başlatır. Kimlik doğrulaması olmadan
#  tetiklenebilen ve iş yapan her adres, ucuz bir hizmet dışı bırakma
#  (DoS) kaldıracıdır. Ayrıca bir yapılandırma hatası (PHP'nin
#  yorumlanmadığı bir an, yanlış bir uzantı) bu dosyaların KAYNAK
#  KODUNU —veritabanı parolasıyla birlikte— düz metin olarak sunar.
#
#  NEDEN BEYAZ LİSTE (önce hepsini reddet, sonra ajax.php'yi aç)?
#  Kara liste yazsaydık ("config.php'yi engelle") projeye yarın eklenen
#  her yeni dosya VARSAYILAN OLARAK AÇIK olurdu ve kimse fark etmezdi.
#  Nitekim bu depoya ölçüm sonrası system/rules.php eklendi; beyaz
#  liste sayesinde o dosya HİÇBİR EK SATIR YAZILMADAN kapalı doğdu.
#  Güvenlikte varsayılanın yönü, kuralın kendisinden önemlidir.
#
#  İkinci katman: dosyaların kendi içindeki CY_APP kontrolü (bkz.
#  config.php / rules.php / function.php). .htaccess'in okunmadığı bir
#  sunucuda (nginx) bu dosya hiçbir şey yapmaz; oradaki PHP kontrolü
#  çalışır. Tek katmana güvenmemenin bedeli üç satırdır.
# =====================================================================

Require all denied

# ajax.php tarayıcıdan çağrılan GERÇEK uç noktadır; açık kalmalıdır.
<Files "ajax.php">
    Require all granted
</Files>
